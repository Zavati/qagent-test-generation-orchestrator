{
  "name": "qagent-test-generation-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/jobs/createProjectGenerationJob.js && node --check src/queue/consumer.js && node --check src/ui/contracts.js && node --check src/ui/repository.js && node --check src/ui/gatewayClient.js && node --check src/ui/service.js && node --check src/ui/routes.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply qagent-test-generation --local",
    "test:f08-1-6": "node --test test/observed-baseline-compatibility.test.mjs",
    "check:08.1.6": "npm run check && npm test",
    "test:f08-1-8": "node --test test/autonomous-learning-08.1.8.test.mjs test/autonomous-repository-08.1.8.test.mjs",
    "test:ui-td2": "node --test test/ui-jobs.test.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply qagent-test-generation --remote"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
